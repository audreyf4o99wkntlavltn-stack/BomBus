<mujoco model="flower_final">
    <compiler angle="radian" meshdir="meshes"/>

    <asset>
        <mesh name="bottle_mesh" file="bottle_link.STL"/>
        <mesh name="plate_mesh" file="plate_Link.STL"/>
        <mesh name="lego_mesh" file="lego_Link.STL"/>
        
        <material name="mat_bottle" rgba="0.8 0.8 1 0.5"/>
        <material name="mat_plate" rgba="1 1 1 1"/>
        <material name="mat_lego" rgba="1 0 0 1"/>
    </asset>

    <worldbody>
        <body name="flower_base" pos="0 0 0">
            <geom type="mesh" mesh="bottle_mesh" material="mat_bottle"/>
            
            <body name="flower_plate" pos="0 0 0.079" euler="0 0 0">
                <geom type="mesh" mesh="plate_mesh" material="mat_plate"/>
                
                <body name="flower_lego" pos="0 0 0" euler="0 0 0">
                    <geom type="mesh" mesh="lego_mesh" material="mat_lego"/>
                    
                    <site name="nectar" pos="0 0 0.01" size="0.005" rgba="1 1 0 1"/>
                </body>
            </body>
        </body>
    </worldbody>
</mujoco>