<mujoco model="fly_env">
  <compiler angle="radian" meshdir="meshes/"/>
  
  <option gravity="0 0 -981"/>

  <asset>
    <material name="mat_wood" rgba="0.55 0.35 0.15 1"/> 
    <material name="mat_glass" rgba="0.9 0.9 0.9 0.3"/> 
    <material name="mat_opaque" rgba="0.5 0.5 0.5 1"/>
    
    <mesh name="flight_box_base" file="flight_box_base.STL" scale="100 100 100"/>
    <mesh name="channel_link" file="channel_link.STL" scale="100 100 100"/>
    <mesh name="feeding_box_link" file="feeding_box_link.STL" scale="100 100 100"/>
  </asset>

  <worldbody>
    <light pos="0 0 300" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="500 500 10" rgba=".8 .9 .8 1"/>
    
    <body name="part1_big_box" pos="0 0 0" euler="0 0 0">
      <geom name="big_floor" type="box" size="30 20 0.5" pos="0 0 0.5" material="mat_wood"/>
      
      <geom name="big_wall_f" type="box" size="30 0.5 12.5" pos="0 19.5 13" material="mat_wood"/>
      <geom name="big_wall_b" type="box" size="30 0.5 12.5" pos="0 -19.5 13" material="mat_wood"/>
      <geom name="big_wall_l" type="box" size="0.5 20 12.5" pos="-29.5 0 13" material="mat_wood"/>
      <geom name="big_wall_r" type="box" size="0.5 20 12.5" pos="29.5 0 13" material="mat_wood"/>
      
      <geom name="big_glass_top" type="box" size="29 19 0.1" pos="0 0 25.5" material="mat_glass"/>
    </body>

    <body name="part2_channel" pos="5 0 0" euler="0 0 0">
      <geom type="mesh" mesh="channel_link" material="mat_glass"/>
    </body>

    <body name="part3_small_box" pos="67 -1.6 0" euler="1.57 -3.14 0">
      <geom type="mesh" mesh="feeding_box_link" material="mat_glass"/>
    </body>
  </worldbody>
</mujoco>