<mujoco model="flower_final">
    <compiler angle="radian" meshdir="meshes"/>

    <asset>
        <mesh name="bottle_mesh" file="bottle_link.STL" scale="25 25 25"/>
        <mesh name="plate_mesh" file="plate_Link.STL" scale="25 25 25"/>
        <mesh name="lego_mesh" file="lego_Link.STL" scale="25 25 25"/>

        <material name="mat_bottle" rgba="0.8 0.8 1 0.5"/>
        <material name="mat_plate" rgba="1 1 1 1"/>
        <material name="mat_lego" rgba="0 0 1 1"/>
        
        <material name="mat_nectar" rgba="1 1 0.6 0.0"/>
    </asset>

    <worldbody>
        <body name="flower_base" pos="0 0 0">
            <geom type="mesh" mesh="bottle_mesh" material="mat_bottle"/>

            <body name="flower_plate" pos="0 0 1.975">
                <geom type="mesh" mesh="plate_mesh" material="mat_plate"/>

                <body name="flower_lego" pos="0 0 0">
                    <geom type="mesh" mesh="lego_mesh" material="mat_lego"/>
                    
                    <geom name="nectar_collision"
                          type="sphere"
                          pos="0 0 0.25"
                          size="0.125"
                          material="mat_nectar"
                          contype="1"
                          conaffinity="1"/>
                </body>
            </body>
        </body>
    </worldbody>
</mujoco>